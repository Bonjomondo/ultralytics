# Keep short benchmark evidence and deliberate report artifacts.
!/docs/experiment_reports/**/raw/benchmark_*.log
!/docs/experiment_reports/**/raw/inference_*/results.csv
!/docs/experiment_reports/**/figures/*.svg

# P2-SFI mutable controller state stays on the server.
/experiments/r18_p2_sfi/queue_status.json
/experiments/r18_p2_sfi/queue_status.tmp

/logs/p2-sfi-*

# Postprocess audit and continuation controller runtime state remain server-only.
/experiments/r18_p2_sfi/corrected_20261024/status.json
/experiments/r18_p2_sfi/convergence_20261024/status.json

!/docs/experiment_reports/2026-10-24_r18_p2_sfi_audit/raw/test_summary.log

!/docs/experiment_reports/2026-10-24_5090_detrscope/raw/pytest_*.log

!/docs/experiment_reports/2026-10-24_5090_baselines/raw/pytest_5090.log

# Small generated 5090 reports are shareable; only the refresh lock is local.
